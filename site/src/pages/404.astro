---
import Base from "@/layouts/Base.astro";
---

<Base title="404 — Not found" noIndex>
  <div class="container" style="padding-block: var(--space-24); text-align: center;">
    <p class="text-mono text-faint" style="font-size: var(--text-5xl); font-weight: 400; margin-bottom: var(--space-6);">404</p>
    <h1 style="margin-bottom: var(--space-4);">Page not found</h1>
    <p class="text-muted" style="margin-bottom: var(--space-8);">
      The page you're looking for doesn't exist or may have moved.
    </p>
    <a href="/" style="font-size: var(--text-base); font-weight: 500; color: var(--color-accent);">
      ← Go home
    </a>
  </div>
</Base>
