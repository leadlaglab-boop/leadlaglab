# Copy this to .env and fill in values. Never commit .env.
# All of these are also stored as GitHub Actions secrets.

# Tiingo (free tier: https://www.tiingo.com/)
TIINGO_API_KEY=

# Optional: Alpha Vantage fallback (https://www.alphavantage.co/)
ALPHA_VANTAGE_KEY=

# SEC EDGAR User-Agent (required by EDGAR; format: "AppName Contact@email.com")
EDGAR_USER_AGENT="LeadLagLab leadlaglab@gmail.com"

# leadlaglab-data repo path (local clone)
DATA_REPO_PATH=../leadlaglab-data

# Archive storage backend: "git" or "r2"
ARCHIVE_BACKEND=git

# Cloudflare R2 (only needed if ARCHIVE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=leadlaglab-data
